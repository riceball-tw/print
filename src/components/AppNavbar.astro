---
interface Props {
	navigation: {
		name: string;
		url: string;
	}[];
}

const { navigation } = Astro.props;
---

<nav
	class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs tracking-widest uppercase md:flex-col md:items-start md:gap-y-2"
>
	{navigation.map((item) => <a class="transition-colors hover:text-accent" href={item.url}>{item.name}</a>)}
</nav>
