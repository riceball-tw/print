---
import type { CollectionEntry } from 'astro:content';
import { getSlugFromId } from '@/i18n/utils';
import { formatDate } from '@/utils/date';
import { withBase } from '@/utils/base';

interface Props {
	shortposts: CollectionEntry<'shortpost'>[];
	currentSlug: string;
	lang?: string;
}

const { shortposts, currentSlug, lang = 'en' } = Astro.props;
---

<ul class="list-none space-y-2" role="list">
	{
		shortposts.map((shortpost) => {
			const isActive = shortpost.id === currentSlug;
			const slug = getSlugFromId(shortpost.id);

			return (
				<li>
					<div class="flex items-baseline gap-3">
						<a class={`min-w-0 truncate transition-opacity ${isActive ? 'tui-active text-accent font-bold opacity-100' : 'opacity-40 hover:opacity-100'}`} aria-label={isActive ? shortpost.data.headline : undefined} href={withBase(`/${lang}/shortposts/${slug}/`)}>
							{shortpost.data.headline}
						</a>
						<span class="flex-1 border-b border-dotted border-ink/25" aria-hidden="true" />
						<span class="shrink-0 font-mono text-xs text-muted">{formatDate(shortpost.data.publishDate)}</span>
					</div>
					{isActive && (
						<div class="mt-2 prose">
							<slot />
						</div>
					)}
				</li>
			);
		})
	}
</ul>
