---
import type { LanguageKey } from '@/i18n/ui';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import { slugify } from '@/utils/slug';

interface Props {
	/** Every category to offer, in display order. */
	categories: string[];
	/** Language prefix for the generated links. */
	lang?: LanguageKey;
	/** The category of the page being viewed; marked as the current one. */
	active?: string;
}

const { categories, lang = 'en', active } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<nav aria-label={t('categories.title')} class="mb-6 md:mb-0">
	<p class="label">{t('categories.title')}</p>
	<ul class="mt-3 list-none space-y-1" role="list">
		{
			categories.map((name) => (
				<li>
					<a
						href={`${translatePath(`/categories/${slugify(name)}`)}/`}
						aria-current={name === active ? 'page' : undefined}
						class={name === active ? 'text-accent' : undefined}
					>
						{name}
					</a>
				</li>
			))
		}
	</ul>
</nav>
