---
import { languages, languageShortNames, type LanguageKey } from '@/i18n/ui';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import { hasTranslation } from '@/utils/translations';

interface Props {
	/** The language the current page is rendered in. */
	lang: LanguageKey;
	/** The current page path without its language prefix, e.g. `/posts`. */
	path: string;
	/** Accessible label for the language navigation landmark. */
	label: string;
}

const { lang, path, label } = Astro.props;
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);
const currentLanguage = languages[lang];
const menuId = 'language-picker-menu';
---

{/*
	One compact control, however many locales the site gains.
	The menu is a popover on the top layer. A short script pins it to the
	trigger and lets the list scroll inside the viewport instead of spilling
	out of the top bar or off the bottom of the sidebar.
*/}
<nav class="label" aria-label={label} data-test="language-picker">
	<button
		type="button"
		class="language-trigger"
		data-test="language-picker-trigger"
		popovertarget={menuId}
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls={menuId}
		aria-label={label}
	>
		<span aria-hidden="true">[{languageShortNames[lang]}]</span>
	</button>
	<ul id={menuId} class="language-menu" popover open data-language-menu>
		{
			Object.entries(languages).map(([key, name]) => (
				<li>
					{key === lang ? (
						<span
							aria-current="true"
							aria-label={name}
							class="tui-active language-option text-accent"
							tabindex="-1"
							data-language-option
						>
							{name}
						</span>
					) : hasTranslation(path, key as LanguageKey) ? (
						<a
							href={translatePath(path, key as LanguageKey)}
							class="language-option"
							aria-label={name}
							tabindex="-1"
							data-language-option
						>
							{name}
						</a>
					) : (
						<span
							class="language-option cursor-not-allowed text-muted line-through decoration-1"
							title={t('language.unavailable')}
							tabindex="-1"
							data-language-option
						>
							{name}
							<span class="sr-only"> ({t('language.unavailable')})</span>
						</span>
					)}
				</li>
			))
		}
	</ul>
</nav>

<style>
	/* Unlayered so these beat the user-agent popover and button rules. */
	.language-trigger {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-muted);
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		white-space: nowrap;
		cursor: pointer;
		user-select: none;
		appearance: none;
	}

	.language-trigger:hover {
		color: var(--color-ink);
	}

	.language-menu {
		position: fixed;
		inset: auto;
		top: 0;
		left: 0;
		width: max-content;
		max-width: calc(100vw - 1rem);
		max-height: min(20rem, calc(100dvh - 1rem));
		margin: 0;
		padding: 0.5rem;
		overflow: auto;
		overscroll-behavior: contain;
		list-style: none;
		border: 1px solid var(--color-line);
		background: var(--color-paper);
		color: inherit;
	}

	.language-option {
		display: block;
		padding: 0.25rem;
		white-space: nowrap;
	}
</style>

<script>
	import { placeLanguageMenu } from '@/utils/placeLanguageMenu';

	const focusOption = (option: HTMLElement) => {
		option.focus({ preventScroll: true });
		const menu = option.closest<HTMLElement>('[data-language-menu]');
		if (!menu) return;

		const menuBox = menu.getBoundingClientRect();
		const optionBox = option.getBoundingClientRect();
		if (optionBox.top < menuBox.top) menu.scrollTop -= menuBox.top - optionBox.top;
		else if (optionBox.bottom > menuBox.bottom) menu.scrollTop += optionBox.bottom - menuBox.bottom;
	};

	const optionsIn = (menu: HTMLElement) => [
		...menu.querySelectorAll<HTMLElement>('[data-language-option]'),
	];

	const place = (trigger: HTMLElement, menu: HTMLElement) => {
		const scrollTop = menu.scrollTop;
		const rect = trigger.getBoundingClientRect();
		menu.style.minWidth = `${rect.width}px`;
		menu.style.maxHeight = 'none';
		const naturalHeight = menu.offsetHeight;
		const triggerBox = {
			top: rect.top,
			right: rect.right,
			bottom: rect.bottom,
			left: rect.left,
		};
		const viewport = { width: window.innerWidth, height: window.innerHeight };
		const placed = placeLanguageMenu({
			trigger: triggerBox,
			menu: { width: menu.offsetWidth, height: naturalHeight },
			viewport,
		});
		menu.style.top = `${placed.top}px`;
		menu.style.left = `${placed.left}px`;
		menu.style.maxHeight = `${placed.maxHeight}px`;
		// A scrollbar can widen the menu after the height is capped.
		const fitted = placeLanguageMenu({
			trigger: triggerBox,
			menu: { width: menu.offsetWidth, height: naturalHeight },
			viewport,
		});
		menu.style.top = `${fitted.top}px`;
		menu.style.left = `${fitted.left}px`;
		menu.scrollTop = scrollTop;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-test="language-picker"]')) {
		const trigger = root.querySelector<HTMLButtonElement>('[data-test="language-picker-trigger"]');
		const menu = root.querySelector<HTMLElement>('[data-language-menu]');
		if (!trigger || !menu) continue;

		const position = () => place(trigger, menu);

		menu.addEventListener('beforetoggle', (event) => {
			if (event instanceof ToggleEvent && event.newState === 'open') {
				menu.style.visibility = 'hidden';
			}
		});

		menu.addEventListener('toggle', (event) => {
			if (!(event instanceof ToggleEvent) || event.newState !== 'open') {
				menu.style.visibility = '';
				return;
			}
			position();
			menu.style.visibility = '';
			const items = optionsIn(menu);
			const current = items.find((item) => item.getAttribute('aria-current') === 'true');
			const initial = current ?? items[0];
			if (initial) focusOption(initial);
		});

		menu.addEventListener('keydown', (event) => {
			const items = optionsIn(menu);
			if (items.length === 0) return;
			const index = items.indexOf(document.activeElement as HTMLElement);
			const focusAt = (next: number) => {
				event.preventDefault();
				const count = items.length;
				focusOption(items[((next % count) + count) % count]);
			};
			if (event.key === 'ArrowDown') focusAt(index < 0 ? 0 : index + 1);
			else if (event.key === 'ArrowUp') focusAt(index < 0 ? items.length - 1 : index - 1);
			else if (event.key === 'Home') focusAt(0);
			else if (event.key === 'End') focusAt(items.length - 1);
		});

		menu.addEventListener('focusout', (event) => {
			const next = event.relatedTarget;
			if (next instanceof Node && (menu.contains(next) || trigger.contains(next))) return;
			if (menu.matches(':popover-open')) menu.hidePopover();
		});

		const reflow = (event: Event) => {
			if (!menu.matches(':popover-open')) return;
			const target = event.target;
			if (target instanceof Node && (target === menu || menu.contains(target))) return;
			position();
		};
		window.addEventListener('resize', reflow);
		window.addEventListener('scroll', reflow, true);
	}
</script>
