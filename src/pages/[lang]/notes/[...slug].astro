---
import CategoryNav from '@/components/CategoryNav.astro';
import Mermaid from '@/components/Mermaid.astro';
import NoteFeed from '@/components/NoteFeed.astro';
import { languages, type LanguageKey } from '@/i18n/ui';
import {
	getLangFromUrl,
	getSlugFromId,
	useTranslatedPath,
	useTranslations,
} from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { noteCategoriesByLang, notesByLang } from '@/utils/notes';
import { render } from 'astro:content';

export function getStaticPaths() {
	return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
		notesByLang(lang).map((note) => ({
			params: { lang, slug: getSlugFromId(note.id) },
			props: { note },
		})),
	);
}

const { note } = Astro.props;
const { Content } = await render(note);
const { headline, category } = note.data;

const lang = getLangFromUrl(Astro.url);
const notes = notesByLang(lang);
const categories = noteCategoriesByLang(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={headline} description={headline} type="article">
	<main class="px-4 pt-6 pb-12">
		<div class="md:flex md:gap-8">
			<CategoryNav categories={categories} lang={lang} active={category} basePath="/notes/categories" />
			<div class="md:min-w-0 md:flex-1">
				<NoteFeed notes={notes} currentSlug={note.id} lang={lang}>
					<Content components={{ Mermaid }} />
				</NoteFeed>
				<hr class="mt-10" />
				<p class="mt-3 font-mono text-xs"><a href={translatePath('/')}>{t('common.back')}</a></p>
			</div>
		</div>
	</main>
</BaseLayout>
