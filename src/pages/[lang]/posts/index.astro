---
import CategoryNav from '@/components/CategoryNav.astro';
import PostItem from '@/components/PostItem.astro';
import { languages } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoriesByLang, postsByLang } from '@/utils/posts.ts';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const posts = postsByLang(lang);
const categories = categoriesByLang(lang);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={t('posts.title')} description={t('posts.description')}>
	<main class="px-4 pt-6 pb-12">
		<div class="md:flex md:gap-8">
			<CategoryNav categories={categories} lang={lang} />
			<div class="md:min-w-0 md:flex-1">
				<h1 class="text-3xl tracking-tight uppercase">{t('posts.title')}</h1>
				<p class="label mt-2">
					{t('posts.count', { count: posts.length })}
				</p>
				<hr class="mt-4" />
				<ul class="mt-6 list-none space-y-2" role="list">
					{posts.map((post) => <PostItem post={post} lang={lang} />)}
				</ul>
				<hr class="mt-10" />
				<p class="mt-3 font-mono text-xs"><a href={translatePath('/')}>{t('common.back')}</a></p>
			</div>
		</div>
	</main>
</BaseLayout>
