---
import { render } from 'astro:content';
import { languages, type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, getSlugFromId, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { postsByLang } from '@/utils/posts.ts';

export function getStaticPaths() {
	return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
		postsByLang(lang)
			.filter((post) => !post.data.isDraft)
			.map((post) => ({
				params: { lang, slug: getSlugFromId(post.id) },
				props: { post },
			})),
	);
}

const { post } = Astro.props;
const { Content } = await render(post);
const { headline, subHeadline, excerpt, category, publishDate } = post.data;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={headline} description={excerpt}>
	<main class="mx-auto max-w-[52rem] px-4 pt-6 pb-12">
		<article>
			<header class="border-b border-line pb-6">
				<p class="label">{publishDate.toISOString().slice(0, 10)} · {category}</p>
				<h1 class="mt-2 text-3xl tracking-tight md:text-4xl">{headline}</h1>
				<p class="mt-3 text-lg text-muted">{subHeadline}</p>
			</header>
			<div class="prose mt-8">
				<Content />
			</div>
		</article>
		<hr class="mt-12" />
		<p class="mt-3 font-mono text-xs"><a href={`${translatePath('/posts')}/`}>{t('posts.all')}</a></p>
	</main>
</BaseLayout>
