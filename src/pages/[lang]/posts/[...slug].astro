---
import { render } from 'astro:content';
import CategoryNav from '@/components/CategoryNav.astro';
import { languages, type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, getSlugFromId, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoriesByLang, postsByLang } from '@/utils/posts.ts';

export function getStaticPaths() {
	return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
		postsByLang(lang)
			.filter((post) => !post.data.isDraft)
			.map((post) => ({
				params: { lang, slug: getSlugFromId(post.id) },
				props: { post },
			})),
	);
}

const { post } = Astro.props;
const { Content } = await render(post);
const { headline, subHeadline, excerpt, category, publishDate } = post.data;

const lang = getLangFromUrl(Astro.url);
const categories = categoriesByLang(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={headline} description={excerpt}>
	<main class="px-4 pt-6 pb-12">
		<div class="md:grid md:grid-cols-[10rem_1fr] md:gap-8">
			<CategoryNav categories={categories} lang={lang} active={category} />
			<div>
				<article>
					<header class="border-b border-line pb-6">
						<p class="label">{publishDate.toISOString().slice(0, 10)} · {category}</p>
						<h1 class="mt-2 text-3xl tracking-tight md:text-4xl">{headline}</h1>
						<p class="mt-3 text-lg text-muted">{subHeadline}</p>
					</header>
					<div class="prose mt-8">
						<Content />
					</div>
				</article>
				<hr class="mt-12" />
				<p class="mt-3 font-mono text-xs">
					<a href={`${translatePath('/posts')}/`}>{t('posts.all')}</a>
				</p>
			</div>
		</div>
	</main>
</BaseLayout>
