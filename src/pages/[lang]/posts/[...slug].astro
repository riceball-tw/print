---
import { render } from 'astro:content';
import { languages, type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, getSlugFromId, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { postsByLang } from '@/utils/posts.ts';

export function getStaticPaths() {
	return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
		postsByLang(lang)
			.filter((post) => !post.data.isDraft)
			.map((post) => ({
				params: { lang, slug: getSlugFromId(post.id) },
				props: { post },
			})),
	);
}

const { post } = Astro.props;
const { Content } = await render(post);
const { headline, subHeadline, excerpt, category, publishDate } = post.data;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={headline} description={excerpt}>
	<main class="mx-auto max-w-[880px] px-3 py-4">
		<article>
			<header>
				<h1>{headline}</h1>
				<p class="font-mono text-xs">
					{publishDate.toISOString().slice(0, 10)} · {category}
				</p>
				<p>{subHeadline}</p>
			</header>
			<hr />
			<Content />
		</article>
		<hr />
		<p class="font-mono text-xs"><a href={`${translatePath('/posts')}/`}>{t('posts.all')}</a></p>
	</main>
</BaseLayout>
