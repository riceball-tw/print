---
import { getEntry } from 'astro:content';
import AutoGrid from '@/components/AutoGrid.astro';
import PostItem from '@/components/PostItem.astro';
import { languages } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hiddenPostCount, previewPosts } from '@/utils/postPreview';
import { postsByCategoryForLang } from '@/utils/posts.ts';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const { brand } = config.data;

const lang = getLangFromUrl(Astro.url);
const postsByCategory = postsByCategoryForLang(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const revision = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={brand.name} description={brand.description}>
	<main class="px-4 pt-6 pb-12">
		<h1 class="sr-only">{brand.name}</h1>
		<section>
			<h2 class="sr-only">{t('home.postsByCategory')}</h2>
			<AutoGrid minCardWidth={600}>
				{
					postsByCategory.map(({ category, posts }) => {
						const hidden = hiddenPostCount(posts.length);
						return (
							<section>
								<h3 class="flex items-baseline justify-between gap-3 border-b border-line pb-2 text-lg">
									<span class="uppercase tracking-wide">{category}</span>
									<span class="font-mono text-xs font-normal tracking-widest text-muted">{posts.length}</span>
								</h3>
								<ul class="mt-3 list-none space-y-2" role="list">
									{previewPosts(posts).map((post) => <PostItem post={post} lang={lang} />)}
									{hidden > 0 && (
										<li>
											<a class="label" href={`${translatePath('/posts')}/`}>
												{t('home.more', { count: hidden })}
											</a>
										</li>
									)}
								</ul>
							</section>
						);
					})
				}
			</AutoGrid>
		</section>
	</main>

	<footer class="px-4 pb-12">
		<hr />
		<p class="mt-3 flex flex-wrap gap-x-2 font-mono text-xs tracking-widest uppercase text-muted">
			<span>{brand.copyright}</span>
			<span>·</span>
			<span>{t('footer.links')}</span>
			{
				brand.socials.map((social) => (
					<a class="text-ink transition-colors hover:text-accent" href={social.url}>
						{social.name}
					</a>
				))
			}
		</p>
		<p class="mt-2 font-mono text-xs"><a href="#top">{t('common.top')}</a></p>
	</footer>
</BaseLayout>
