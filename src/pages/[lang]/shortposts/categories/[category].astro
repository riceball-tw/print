---
import CategoryNav from '@/components/CategoryNav.astro';
import ShortpostItem from '@/components/ShortpostItem.astro';
import { languages, type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { shortpostCategoriesByLang, shortpostsByLang } from '@/utils/shortposts';
import { slugify } from '@/utils/slug';

export function getStaticPaths() {
	return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
		shortpostCategoriesByLang(lang).map((category) => ({
			params: { lang, category: slugify(category) },
			props: { category },
		})),
	);
}

const lang = getLangFromUrl(Astro.url);
const { category } = Astro.props;
const categories = shortpostCategoriesByLang(lang);
const shortposts = shortpostsByLang(lang).filter(
	(shortpost) => shortpost.data.category === category,
);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={`${category} · ${t('shortposts.title')}`} description={t('shortposts.description')}>
	<main class="px-4 pt-6 pb-12">
		<div class="md:flex md:gap-8">
			<CategoryNav categories={categories} lang={lang} active={category} basePath="/shortposts/categories" />
			<div class="md:min-w-0 md:flex-1">
				<h1 class="text-3xl tracking-tight uppercase">{category}</h1>
				<p class="label mt-2">
					{t('shortposts.count', { count: shortposts.length })}
				</p>
				<hr class="mt-4" />
				<ul class="mt-6 list-none space-y-2" role="list">
					{shortposts.map((shortpost) => <ShortpostItem shortpost={shortpost} lang={lang} />)}
				</ul>
				<hr class="mt-10" />
				<p class="mt-3 font-mono text-xs"><a href={translatePath('/shortposts')}>{t('common.back')}</a></p>
			</div>
		</div>
	</main>
</BaseLayout>
