---
import PostItem from '@/components/PostItem.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dateSortedPublishedPosts } from '@/utils/posts.ts';

const posts = dateSortedPublishedPosts;
---

<BaseLayout title="Posts" description="Every post, newest first.">
	<main class="mx-auto">
		<h1>Posts</h1>
		<p class="font-mono text-xs">
			{posts.length} entries
		</p>
		<hr />
		<ul class="list-none" role="list">
			{posts.map((post) => <PostItem post={post} />)}
		</ul>
		<hr />
		<p class="font-mono text-xs"><a href="/">[ back ]</a></p>
	</main>
</BaseLayout>
