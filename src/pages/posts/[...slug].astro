---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('post', (post) => !post.data.isDraft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { headline, subHeadline, excerpt, category, publishDate } = post.data;
---

<BaseLayout title={headline} description={excerpt}>
	<main class="mx-auto max-w-[880px] px-3 py-4">
		<article>
			<header>
				<h1>{headline}</h1>
				<p class="font-mono text-xs">
					{publishDate.toISOString().slice(0, 10)} · {category}
				</p>
				<p>{subHeadline}</p>
			</header>
			<hr />
			<Content />
		</article>
		<hr />
		<p class="font-mono text-xs"><a href="/posts/">[ all posts ]</a></p>
	</main>
</BaseLayout>
