---
import '@/styles/global.css';
import { getEntry } from 'astro:content';
import AppNavbar from '@/components/AppNavbar.astro';
import LanguagePicker from '@/components/LanguagePicker.astro';
import { languageTags } from '@/i18n/ui';
import { getLangFromUrl, getPathFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import { buildNav } from '@/utils/nav';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'A minimal Astro site.' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const path = getPathFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const { brand, navigation } = config.data;
const nav = buildNav(navigation, t, translatePath);
const homeUrl = translatePath('/');
---

<!doctype html>
<html lang={languageTags[lang]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<header
			id="top"
			data-test="navbar"
			class="fixed left-0 top-0 flex h-(--navbar-height) w-full items-center justify-between md:h-full md:w-(--navbar-width) md:flex-col md:items-start md:justify-start"
		>
			<a class="text-xl font-bold" href={homeUrl}>{brand.name} <span class="animate-blink" aria-hidden="true">█</span></a>
			<AppNavbar navigation={nav} />
		</header>
		<div class="mt-(--navbar-height) md:mt-0 md:ml-(--navbar-width)">
			<slot />
			<div class="mx-auto px-3 pt-2 pb-10">
				<LanguagePicker lang={lang} path={path} label={t('language.select')} />
			</div>
		</div>
	</body>
</html>
